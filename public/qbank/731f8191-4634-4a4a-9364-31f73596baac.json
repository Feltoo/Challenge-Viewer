)\n\nmat = []\nfor i in range(rows):\n    row = []\n    for j in range(cols):\n        row.append(0)\n    mat.append(row)\n\ndisplay(mat)\n\nans2 = input(\"Input row and column: \")\nr_idx = int(ans2.split()[0])\nc_idx = int(ans2.split()[1])\n\nmat[r_idx][c_idx] = 1\ndisplay(mat)\n"}, {"difficulty": "hard", "step_id": 1, "description": "<p><font face=\"Arial\"><span style=\"font-weight: bolder;\">Read up the notes on 2D List.</span></font></p><p><span style=\"font-weight: bolder;\"><span style=\"font-family: Arial;\">Click\u00a0</span></span><a href=\"https://docs.google.com/presentation/d/1rPHNtUNX5i_AA6rH-1L3iT1jRghAg1kM/edit?usp=sharing&ouid=108663561560129273777&rtpof=true&sd=true\" target=\"_blank\" style=\"font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"; font-weight: 400; background-color: rgb(255, 255, 255);\"><span style=\"font-weight: bolder;\"><u style=\"color: rgb(57, 132, 198);\">here</u></span></a>\u00a0<span style=\"font-weight: bolder;\"><span style=\"color: rgb(0, 0, 255); text-decoration-line: underline; font-family: Arial;\"></span><span style=\"font-family: Arial;\">to view the notes.</span></span><br></p><p><span style=\"font-weight: bolder;\"><span style=\"font-family: Arial;\">The instructor will then brief you on the topic.</span></span></p>", "ide": "python", "quiz": "", "worksheet": ""}, {"difficulty": "hard", "step_id": 2, "description": "<p><span style=\"font-family: Arial; font-size: 15px; white-space: pre-wrap; text-decoration-skip-ink: none;\">Create a </span><span style=\"font-family: Arial; font-size: 15px; white-space: pre-wrap; font-weight: bold; text-decoration-skip-ink: none;\">function </span><span style=\"font-family: Arial; font-size: 15px; white-space: pre-wrap; text-decoration-skip-ink: none;\">that takes in a 2D list and display it in columns and rows.\n</span></p><p