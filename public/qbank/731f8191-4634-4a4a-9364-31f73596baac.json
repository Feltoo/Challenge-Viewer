: italic; text-decoration-skip-ink: none;\">Example 2</span><span style=\"text-decoration-skip-ink: none;\">\nInput row size and column size: </span><span style=\"color: rgb(255, 0, 0); text-decoration-skip-ink: none;\">2 4</span><span style=\"text-decoration-skip-ink: none;\">\n0 8 6 4 \n7 9 0 0 \nAfter increasing by 1\n1 9 7 5 \n8 0 1 1 </span></span></p>", "ide": "python", "quiz": "", "worksheet": "", "answer": "import random\n\ndef display(mat):\n    for r in mat:\n        for c in r:\n            print(c, end=\" \")\n        print()\n\nans = input(\"Input row size and column size: \")\nrows = int(ans.split()[0])\ncols = int(ans.split()[1])\n\nmat = []\nfor i in range(rows):\n    row = []\n    for j in range(cols):\n        row.append(random.randint(0, 9))\n    mat.append(row)\n\ndisplay(mat)\n"}], "ide_types": ["python"], "assets": []}